# Backend .env — copie para .env.local para rodar localmente

# Banco de dados SQLite
DATABASE_URL="file:./prisma/dev.db"

# JWT secret (mínimo 32 caracteres)
JWT_SECRET="change-me-to-a-long-random-secret-here"

# Credenciais do admin inicial (usado no seed)
ADMIN_EMAIL="admin@acidc.com.br"
ADMIN_PASSWORD="change-me"

# CORS — origem do frontend
# Dev local: http://localhost:5173  |  Docker: http://localhost  |  Produção: https://seudominio.com.br
FRONTEND_URL="http://localhost:5173"
