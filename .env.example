# Root .env — usado pelo docker-compose
# Copie para .env e preencha os valores

# JWT secret (mínimo 32 caracteres)
JWT_SECRET=change-me-to-a-long-random-secret-here

# Credenciais do admin
ADMIN_EMAIL=admin@acidc.com.br
ADMIN_PASSWORD=change-me

# CORS — origem do frontend que o backend vai permitir
FRONTEND_URL=https://acidc.com.br

# A API usa o mesmo domínio e é roteada pelo Traefik em /api
VITE_API_URL=https://acidc.com.br

# Domínio usado nas regras do Traefik
DOMAIN=acidc.com.br
