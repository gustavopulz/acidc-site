# Root .env — usado pelo docker-compose
# Copie para .env e preencha os valores

# JWT secret (mínimo 32 caracteres)
JWT_SECRET=change-me-to-a-long-random-secret-here

# Credenciais do admin
ADMIN_EMAIL=admin@acidc.com.br
ADMIN_PASSWORD=change-me

# CORS — origem do frontend que o backend vai permitir
# Docker local: http://localhost  |  Produção: https://seudominio.com.br
FRONTEND_URL=http://localhost

# URL do backend — passada ao Vite no build da imagem Docker
# Docker local: http://localhost:3001  |  Produção: https://api.seudominio.com.br
VITE_API_URL=http://localhost:3001
